---
/**
 * Layout para páginas internas: encabezado de página con migas de pan
 * (y su JSON-LD BreadcrumbList) sobre el BaseLayout.
 */
import BaseLayout, { type Props as BaseProps } from './BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { jsonLdMigas, type Miga } from '@/lib/seo';

interface Props extends BaseProps {
  title: string;
  /** Título visible (h1). Por defecto, `title`. */
  encabezado?: string;
  eyebrow?: string;
  lead?: string;
}

const { title, encabezado = title, eyebrow, lead, jsonLd = [], ...resto } = Astro.props;
const migas: Miga[] = [
  { nombre: 'Inicio', href: '/' },
  { nombre: title, href: Astro.url.pathname },
];
---

<BaseLayout title={title} jsonLd={[jsonLdMigas(migas), ...jsonLd]} {...resto}>
  <section class="relative isolate overflow-hidden bg-celeste-50/70">
    <!-- Manchas de color del manual -->
    <div class="pointer-events-none absolute inset-0 -z-10 hidden sm:block" aria-hidden="true">
      <span class="absolute -top-16 -right-10 size-56 rounded-[40%] bg-yellow/60"></span>
      <span class="absolute right-48 -bottom-10 size-20 rounded-full bg-coral/50"></span>
    </div>
    <div class="container-page pt-8 pb-12 sm:pt-10 sm:pb-16">
      <Breadcrumbs migas={migas} />
      {eyebrow && <p class="eyebrow animate-fade-up mt-8">{eyebrow}</p>}
      <h1
        class:list={[
          'animate-fade-up max-w-3xl text-4xl leading-tight font-extrabold [animation-delay:60ms] sm:text-5xl',
          eyebrow ? 'mt-4' : 'mt-8',
        ]}
      >
        {encabezado}
      </h1>
      {lead && <p class="animate-fade-up mt-5 max-w-2xl text-lg leading-relaxed text-gray-600 [animation-delay:120ms] sm:text-xl">{lead}</p>}
      <slot name="hero" />
    </div>
  </section>
  <slot />
</BaseLayout>
