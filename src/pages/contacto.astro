---
import PageLayout from '@/layouts/PageLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import OpenStatus from '@/components/OpenStatus.astro';
import Icon, { type NombreIcono } from '@/components/Icon.astro';
import { negocio } from '@/lib/negocio';
import { direccionCompleta, urlCorreo, urlGoogleMaps, urlWhatsApp } from '@/lib/utils';

const canales: { icono: NombreIcono; titulo: string; valor: string; href: string; nota: string; externo?: boolean; destacado?: boolean }[] = [
  {
    icono: 'whatsapp',
    titulo: 'WhatsApp',
    valor: negocio.contacto.telefono,
    href: urlWhatsApp(),
    nota: 'La forma más rápida: envía archivos y listas.',
    externo: true,
    destacado: true,
  },
  {
    icono: 'mail',
    titulo: 'Correo',
    valor: negocio.contacto.correo,
    href: urlCorreo('Información — Papelería La Reforma'),
    nota: 'Para cotizaciones con más detalle.',
  },
  {
    icono: 'map-pin',
    titulo: 'Tienda',
    valor: direccionCompleta(),
    href: urlGoogleMaps(),
    nota: 'Ven a visitarnos.',
    externo: true,
  },
];
---

<PageLayout
  title="Contacto"
  eyebrow="Contacto"
  encabezado="Hablemos"
  lead="Escríbenos por WhatsApp o déjanos un mensaje. Te respondemos en horario de atención."
  description={`Contacta a ${negocio.nombre} en San Luis Potosí: WhatsApp ${negocio.contacto.telefono}, correo ${negocio.contacto.correo} o formulario en línea.`}
  sinWhatsAppFlotante
>
  <section class="py-16 sm:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Canales directos -->
      <div class="lg:col-span-5">
        <h2 class="text-2xl font-bold" data-reveal>Contacto directo</h2>
        <ul class="mt-6 grid gap-4">
          {
            canales.map((c, i) => (
              <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <a
                  href={c.href}
                  target={c.externo ? '_blank' : undefined}
                  rel={c.externo ? 'noopener' : undefined}
                  class:list={[
                    'group flex items-start gap-4 rounded-2xl border p-5 transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-0.5 hover:shadow-lift',
                    c.destacado ? 'border-green-700/30 bg-green-50' : 'border-gray-200 bg-white hover:border-primary/25',
                  ]}
                >
                  <span
                    class:list={[
                      'grid size-12 shrink-0 place-items-center rounded-xl',
                      c.destacado ? 'bg-green-700 text-white' : 'bg-navy/5 text-primary group-hover:bg-navy group-hover:text-yellow',
                      'transition-colors',
                    ]}
                  >
                    <Icon name={c.icono} size={22} />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-semibold text-gray-600">{c.titulo}</span>
                    <span class="block font-semibold break-words text-navy">{c.valor}</span>
                    <span class="mt-0.5 block text-sm text-gray-600">{c.nota}</span>
                  </span>
                  <Icon name="arrow-right" size={18} class="mt-1 shrink-0 text-gray-400 transition-transform group-hover:translate-x-1 group-hover:text-navy" />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-6" data-reveal>
          <OpenStatus variante="card" />
        </div>
      </div>

      <!-- Formulario -->
      <div class="lg:col-span-7" id="formulario">
        <div data-reveal class="card p-6 sm:p-10">
          <h2 class="text-2xl font-bold">Envíanos un mensaje</h2>
          <p class="mt-2 mb-8 text-gray-600">Cuéntanos qué necesitas y te respondemos por correo o WhatsApp.</p>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</PageLayout>
