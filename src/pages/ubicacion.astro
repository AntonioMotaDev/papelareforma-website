---
import PageLayout from '@/layouts/PageLayout.astro';
import ScheduleTable from '@/components/ScheduleTable.astro';
import MapEmbed from '@/components/MapEmbed.astro';
import CopyAddress from '@/components/CopyAddress.astro';
import OpenStatus from '@/components/OpenStatus.astro';
import Icon from '@/components/Icon.astro';
import { negocio } from '@/lib/negocio';
import { resumenHorarios, urlComoLlegar, urlGoogleMaps, urlTelefono, urlWhatsApp } from '@/lib/utils';

const abreDiario = negocio.horarios.every((h) => h.turnos.length > 0);
---

<PageLayout
  title="Horarios y ubicación"
  eyebrow="Visítanos"
  encabezado="Horarios y ubicación"
  lead={`Estamos en ${negocio.ubicacion.calle}, ${negocio.ubicacion.colonia}, ${negocio.ubicacion.ciudad}.${abreDiario ? ' Abrimos todos los días.' : ''}`}
  description={`Horario y dirección de ${negocio.nombre}: ${negocio.ubicacion.calle}, ${negocio.ubicacion.colonia}, ${negocio.ubicacion.ciudad}, ${negocio.ubicacion.estado}. ${resumenHorarios()}`}
>
  <section class="py-16 sm:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Horarios -->
      <div class="lg:col-span-5" id="horarios">
        <div data-reveal>
          <h2 class="text-3xl font-bold">Horario de atención</h2>
          <p class="mt-2 text-gray-600">Hora local de {negocio.ubicacion.ciudad}.</p>
        </div>

        <div class="mt-6" data-reveal>
          <OpenStatus variante="card" />
        </div>

        <div class="mt-6" data-reveal>
          <ScheduleTable />
        </div>
      </div>

      <!-- Mapa y dirección -->
      <div class="flex flex-col gap-5 lg:col-span-7" id="mapa">
        <h2 class="sr-only">Ubicación</h2>
        <div data-reveal class="flex-1">
          <MapEmbed class="h-full" />
        </div>
        <div data-reveal>
          <CopyAddress />
        </div>
        <div class="grid gap-3 sm:grid-cols-3" data-reveal>
          <a href={urlComoLlegar()} target="_blank" rel="noopener" class="btn btn-navy">
            <Icon name="navigation" size={18} />
            Cómo llegar
          </a>
          <a href={urlGoogleMaps()} target="_blank" rel="noopener" class="btn btn-outline">
            <Icon name="external-link" size={18} />
            Google Maps
          </a>
          <a
            href={urlWhatsApp('Hola, ¿me pueden compartir su ubicación?')}
            target="_blank"
            rel="noopener"
            class="btn btn-whatsapp"
          >
            <Icon name="whatsapp" size={18} />
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16 sm:py-20" aria-labelledby="antes-titulo">
    <div class="container-page">
      <h2 id="antes-titulo" class="text-center text-3xl font-bold" data-reveal>Antes de venir</h2>
      <ul class="mx-auto mt-10 grid max-w-5xl gap-5 md:grid-cols-3">
        <li class="card p-6" data-reveal>
          <Icon name="coffee" size={26} class="text-primary" />
          <h3 class="mt-4 text-lg font-semibold">Receso de comida</h3>
          <p class="mt-2 text-gray-600">{negocio.avisoReceso}</p>
        </li>
        <li class="card p-6" data-reveal style="--reveal-delay:80ms">
          <Icon name="whatsapp" size={26} class="text-green-700" />
          <h3 class="mt-4 text-lg font-semibold">Adelanta tu pedido</h3>
          <p class="mt-2 text-gray-600">
            Envíanos tus archivos por
            <a href={urlWhatsApp('Hola, quiero adelantar un pedido.')} target="_blank" rel="noopener" class="link">WhatsApp</a>
            y pasa por ellos sin esperar.
          </p>
        </li>
        <li class="card p-6" data-reveal style="--reveal-delay:160ms">
          <Icon name="phone" size={26} class="text-primary" />
          <h3 class="mt-4 text-lg font-semibold">¿Dudas? Llámanos</h3>
          <p class="mt-2 text-gray-600">
            Te atendemos al <a href={urlTelefono()} class="link">{negocio.contacto.telefono}</a> en horario de atención.
          </p>
        </li>
      </ul>
    </div>
  </section>
</PageLayout>
