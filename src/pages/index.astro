---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CategoriaCard from '@/components/CategoriaCard.astro';
import ProductoCard from '@/components/ProductoCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import MapEmbed from '@/components/MapEmbed.astro';
import OpenStatus from '@/components/OpenStatus.astro';
import Faq from '@/components/Faq.astro';
import Icon from '@/components/Icon.astro';
import { negocio } from '@/lib/negocio';
import { agruparHorarios, direccionCompleta, formatearTurnos, urlComoLlegar, urlWhatsApp } from '@/lib/utils';

const tonos = ['azul', 'verde', 'amarillo', 'coral'] as const;
const grupos = agruparHorarios();
---

<BaseLayout>
  <Hero />

  <!-- Categorías -->
  <section class="container-page py-16 sm:py-24" aria-labelledby="categorias-titulo">
    <SectionHeading
      id="categorias-titulo"
      titulo="¿Qué estás buscando?"
      descripcion="Lo que necesitas para estudiar, trabajar y crear."
    />
    <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
      {
        negocio.categorias.map((c, i) => (
          <CategoriaCard categoria={c} href={`/productos#${c.id}`} tono={tonos[i % 4]} retraso={(i % 3) * 70} />
        ))
      }
    </div>
  </section>

  <!-- Productos destacados -->
  <section class="container-page pb-16 sm:pb-24" aria-labelledby="destacados-titulo">
    <SectionHeading
      id="destacados-titulo"
      titulo="Pequeñas cosas que hacen grandes ideas."
      descripcion="Algunos de los artículos que más nos piden."
    />
    <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
      {negocio.productosDestacados.map((p, i) => <ProductoCard producto={p} tono={tonos[i % 4]} retraso={i * 70} />)}
    </div>
  </section>

  <!-- Pedidos desde el celular -->
  <section class="container-page pb-16 sm:pb-24" aria-labelledby="pedidos-titulo">
    <SectionHeading
      id="pedidos-titulo"
      eyebrow="Desde tu celular"
      titulo="Adelanta tu pedido por WhatsApp."
      descripcion="Mándanos lo que necesitas y pasa cuando esté listo."
    />
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        [
          {
            href: '/lista-escolar',
            icono: 'clipboard-list',
            titulo: 'Surtimos tu lista escolar',
            texto: 'Mándanos la foto de tu lista y nosotros la surtimos. Tú solo pasas por ella.',
            cta: 'Ver cómo funciona',
          },
          {
            href: '/productos#cotizador',
            icono: 'calculator',
            titulo: 'Calcula tu cotización',
            texto: 'Copias, impresiones, engargolados y enmicados: elige cantidades y pídelo ya armado.',
            cta: 'Abrir calculadora',
          },
        ].map((c, i) => (
          <a
            href={c.href}
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
            class="group flex items-start gap-5 rounded-2xl border border-gray-200 bg-white p-6 shadow-soft transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lift sm:p-8"
          >
            <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-navy/5 text-primary transition-colors duration-300 group-hover:bg-navy group-hover:text-yellow">
              <Icon name={c.icono as 'calculator'} size={26} />
            </span>
            <span>
              <span class="block text-xl font-bold text-navy">{c.titulo}</span>
              <span class="mt-1.5 block leading-relaxed text-gray-600">{c.texto}</span>
              <span class="mt-4 inline-flex items-center gap-2 font-semibold text-primary">
                {c.cta}
                <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Valores -->
  <section class="bg-celeste-50/70 py-16 sm:py-20" aria-labelledby="valores-titulo">
    <div class="container-page">
      <SectionHeading id="valores-titulo" titulo={`Más de ${negocio.experiencia.anios} años siendo tu papelería en ${negocio.ubicacion.ciudad}.`} />
      <ul class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0 lg:divide-x lg:divide-celeste">
        {
          negocio.valores.map((v, i) => (
            <li data-reveal style={`--reveal-delay:${i * 70}ms`} class="px-6 text-center">
              <span class="mx-auto grid size-16 place-items-center rounded-full border-2 border-primary text-primary">
                <Icon name={v.icono} size={28} />
              </span>
              <h3 class="mt-4 text-xl font-bold">{v.titulo}</h3>
              <p class="mx-auto mt-2 max-w-xs text-gray-600">{v.descripcion}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />

  <!-- Visítanos -->
  <section class="container-page pb-16 sm:pb-24" aria-labelledby="visitanos-titulo">
    <SectionHeading id="visitanos-titulo" titulo="Visítanos, estamos para ayudarte." />
    <div class="mt-10 grid gap-8 lg:grid-cols-[3fr_2fr] lg:gap-0 lg:divide-x lg:divide-gray-200">
      <div class="flex flex-col items-center gap-5 lg:pr-10" data-reveal>
        <MapEmbed class="w-full lg:min-h-[22rem]" />
        <a href={urlComoLlegar()} target="_blank" rel="noopener" class="btn btn-primary">
          <Icon name="navigation" size={18} />
          Cómo llegar
        </a>
      </div>
      <div class="flex flex-col gap-7 lg:pl-10" data-reveal>
        <div class="flex gap-4">
          <Icon name="map-pin" size={26} class="mt-0.5 shrink-0 text-navy" />
          <div>
            <h3 class="text-lg font-bold">Encuéntranos</h3>
            <address class="mt-1 text-gray-600 not-italic">{direccionCompleta()}</address>
          </div>
        </div>
        <div class="flex gap-4">
          <Icon name="clock" size={26} class="mt-0.5 shrink-0 text-navy" />
          <div>
            <h3 class="text-lg font-bold">Horarios</h3>
            <dl class="mt-1 text-gray-600">
              {
                grupos.map((g) => (
                  <div class="flex flex-wrap gap-x-2">
                    <dt class="font-semibold text-gray-700">{g.etiqueta}:</dt>
                    <dd>{formatearTurnos(g.turnos)}</dd>
                  </div>
                ))
              }
            </dl>
            <div class="mt-3"><OpenStatus /></div>
          </div>
        </div>
        <div class="border-t border-gray-200 pt-7">
          <a href={urlWhatsApp()} target="_blank" rel="noopener" class="btn btn-outline">
            <Icon name="whatsapp" size={18} />
            Escríbenos
          </a>
        </div>
      </div>
    </div>
  </section>

  <Faq />
</BaseLayout>
