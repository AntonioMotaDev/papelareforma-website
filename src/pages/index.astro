---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import PromoBanner from '@/components/PromoBanner.astro';
import PaymentMethods from '@/components/PaymentMethods.astro';
import OpenStatus from '@/components/OpenStatus.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { negocio } from '@/lib/negocio';
import { obtenerPromociones, obtenerServicios } from '@/lib/api';
import {
  agruparHorarios,
  direccionCompleta,
  formatearTurnos,
  urlComoLlegar,
} from '@/lib/utils';

const servicios = await obtenerServicios();
const destacados = servicios.filter((s) => s.destacado);
const [promo] = await obtenerPromociones();
const grupos = agruparHorarios();
const diasAbiertos = negocio.horarios.filter((h) => h.turnos.length > 0).length;
---

<BaseLayout>
  <Hero />

  <!-- Servicios destacados -->
  <section class="bg-gray-50 py-20 sm:py-28" aria-labelledby="servicios-titulo">
    <div class="container-page">
      <SectionHeading
        id="servicios-titulo"
        eyebrow="Servicios"
        titulo="Lo que más nos piden, al mejor precio"
        descripcion="Precios base publicados y trabajo al momento. Si no ves lo que buscas, pregúntanos: seguro te ayudamos."
      />
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {destacados.map((s, i) => <ServiceCard servicio={s} retraso={i * 80} />)}
      </div>
      <div class="mt-12 text-center" data-reveal>
        <a href="/servicios" class="btn btn-outline">
          Ver los {servicios.length} servicios
          <Icon name="arrow-right" size={18} class="icon-nudge" />
        </a>
      </div>
    </div>
  </section>

  <!-- Promoción -->
  {
    promo && (
      <div class="container-page py-20 sm:py-24">
        <PromoBanner promo={promo} />
      </div>
    )
  }

  <!-- Por qué elegirnos -->
  <section class:list={['pb-20 sm:pb-24', !promo && 'pt-20 sm:pt-24']} aria-labelledby="valores-titulo">
    <div class="container-page grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          id="valores-titulo"
          alineacion="left"
          eyebrow="¿Por qué La Reforma?"
          titulo={`Más de ${negocio.experiencia.anios} años siendo la papelería del barrio`}
          descripcion="Generaciones de estudiantes, familias y negocios de San Luis Potosí nos confían sus tareas, trámites y proyectos."
        >
          <a href="/nosotros" class="link mt-6 inline-flex items-center gap-1.5">
            Conoce nuestra historia
            <Icon name="arrow-right" size={16} />
          </a>
        </SectionHeading>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-7">
        {
          negocio.valores.map((v, i) => (
            <li
              data-reveal
              style={`--reveal-delay:${i * 90}ms`}
              class="card group p-6 transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-lift"
            >
              <span class="grid size-12 place-items-center rounded-2xl bg-yellow/20 text-navy transition-colors group-hover:bg-yellow">
                <Icon name={v.icono} size={22} />
              </span>
              <h3 class="mt-5 text-lg font-semibold">{v.titulo}</h3>
              <p class="mt-2 leading-relaxed text-gray-600">{v.descripcion}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Horarios y ubicación (resumen) -->
  <section class="on-dark relative isolate overflow-hidden bg-navy py-20 text-white sm:py-24" aria-labelledby="visitanos-titulo">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
    <div class="container-page grid items-center gap-12 lg:grid-cols-2">
      <div>
        <SectionHeading
          id="visitanos-titulo"
          alineacion="left"
          oscuro
          eyebrow="Visítanos"
          titulo={diasAbiertos === 7 ? 'Te esperamos los 7 días de la semana' : `Te esperamos ${diasAbiertos} días a la semana`}
        />
        <div class="mt-8" data-reveal>
          <OpenStatus variante="pill-dark" />
        </div>
        <dl class="mt-8 grid gap-4 sm:grid-cols-2" data-reveal>
          {
            grupos.map((g) => (
              <div class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
                <dt class="flex items-center gap-2 text-sm font-semibold tracking-wide text-yellow uppercase">
                  <Icon name="calendar" size={16} />
                  {g.etiqueta}
                </dt>
                <dd class="mt-2 font-display text-xl font-semibold text-white">
                  {g.turnos.map((t) => (
                    <span class="block">{formatearTurnos([t])}</span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-4 flex items-center gap-2 text-sm text-white/70" data-reveal>
          <Icon name="coffee" size={16} />
          {negocio.avisoReceso}
        </p>
      </div>

      <div data-reveal class="rounded-[2rem] bg-white p-6 text-gray-700 shadow-2xl sm:p-8">
        <span class="grid size-14 place-items-center rounded-2xl bg-navy text-yellow">
          <Icon name="map-pin" size={26} />
        </span>
        <h3 class="mt-6 text-2xl font-bold">Estamos en {negocio.ubicacion.calle}</h3>
        <address class="mt-3 text-lg leading-relaxed not-italic">{direccionCompleta()}</address>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={urlComoLlegar()} target="_blank" rel="noopener" class="btn btn-navy">
            <Icon name="navigation" size={18} />
            Cómo llegar
          </a>
          <a href="/ubicacion" class="btn btn-outline">
            Ver mapa y horarios
            <Icon name="arrow-right" size={18} class="icon-nudge" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Formas de pago -->
  <section class="bg-gray-50 py-20 sm:py-24" aria-labelledby="pagos-titulo">
    <div class="container-page">
      <SectionHeading
        id="pagos-titulo"
        eyebrow="Formas de pago"
        titulo="Paga como prefieras"
        descripcion="Aceptamos efectivo, tarjeta y transferencia para que tu compra sea rápida y sin complicaciones."
      />
      <div class="mx-auto mt-12 max-w-4xl">
        <PaymentMethods />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
