---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { negocio } from '@/lib/negocio';
import { urlWhatsApp } from '@/lib/utils';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe." noindex>
  <section class="relative isolate overflow-hidden py-24 sm:py-32">
    <div class="bg-grid-light absolute inset-0 -z-10 [mask-image:radial-gradient(60%_60%_at_50%_40%,black,transparent)]" aria-hidden="true"></div>
    <div class="container-page text-center">
      <p class="animate-fade-up font-display text-8xl font-bold text-navy sm:text-9xl">
        4<span class="text-yellow">0</span>4
      </p>
      <h1 class="animate-fade-up mt-6 text-3xl font-bold [animation-delay:80ms] sm:text-4xl">
        Esta hoja se perdió entre las copias
      </h1>
      <p class="animate-fade-up mx-auto mt-4 max-w-lg text-lg text-gray-600 [animation-delay:140ms]">
        La página que buscas no existe o cambió de lugar. Te ayudamos a encontrar lo que necesitas.
      </p>
      <div class="animate-fade-up mt-10 flex flex-col justify-center gap-3 [animation-delay:200ms] sm:flex-row">
        <a href="/" class="btn btn-navy">
          <Icon name="home" size={18} />
          Ir al inicio
        </a>
        <a href="/productos" class="btn btn-outline">Ver productos</a>
        <a href={urlWhatsApp()} target="_blank" rel="noopener" class="btn btn-whatsapp">
          <Icon name="whatsapp" size={18} />
          Preguntar a {negocio.nombreCorto}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
