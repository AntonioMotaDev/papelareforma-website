---
/**
 * Preguntas frecuentes (acordeón nativo con <details>, sin JavaScript) y su JSON-LD FAQPage.
 * Las respuestas se arman con los datos de negocio.ts para que nunca se contradigan.
 * Sin `preguntas` muestra las generales del negocio.
 */
import Icon from './Icon.astro';
import { negocio } from '@/lib/negocio';
import { direccionCompleta, formatearPrecio, resumenHorarios } from '@/lib/utils';

interface Pregunta {
  pregunta: string;
  respuesta: string;
}
interface Props {
  titulo?: string;
  preguntas?: Pregunta[];
}
const { titulo = '¿Tienes alguna duda?', preguntas: propias } = Astro.props;

const promoListas = negocio.promociones.find((p) => p.id === 'listas-escolares' && p.activa);
const tarjeta = negocio.pagos.metodos.find((m) => m.id === 'tarjeta');

const generales: Pregunta[] = [
  {
    pregunta: '¿Cómo puedo saber si tienen un producto?',
    respuesta: `Escríbenos por WhatsApp al ${negocio.contacto.telefono} con el nombre o una foto de lo que buscas y te decimos si lo tenemos.`,
  },
  {
    pregunta: '¿Puedo preguntar precios antes de ir?',
    respuesta: 'Sí. Por WhatsApp te pasamos precio y disponibilidad antes de que vengas.',
  },
  {
    pregunta: '¿Me surten la lista escolar?',
    respuesta: `Sí. Mándanos la lista por WhatsApp y te la armamos.${promoListas ? ` Con la lista completa tienes ${promoListas.descuento} % de descuento (${promoListas.vigencia.toLowerCase()}).` : ''}`,
  },
  {
    pregunta: '¿Imprimen CURP y actas de nacimiento?',
    respuesta:
      'Sí. Sacamos e imprimimos tu CURP, tu acta de nacimiento y tu constancia de no derechohabiencia al momento. Si tienes dudas sobre lo que necesitas, escríbenos por WhatsApp.',
  },
  {
    pregunta: '¿Qué formas de pago aceptan?',
    respuesta: `${negocio.pagos.metodos.map((m) => m.nombre).join(', ')}.${tarjeta?.minimo ? ` Con tarjeta, la compra mínima es de ${formatearPrecio(tarjeta.minimo)}.` : ''}`,
  },
  {
    pregunta: '¿Dónde están y a qué hora abren?',
    respuesta: `En ${direccionCompleta()}. ${resumenHorarios()}`,
  },
];

const preguntas = propias ?? generales;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((p) => ({
    '@type': 'Question',
    name: p.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
  })),
};
---

<section class="container-page pb-20 sm:pb-24" aria-labelledby="faq-titulo">
  <h2 id="faq-titulo" class="text-center text-3xl font-extrabold sm:text-4xl" data-reveal>{titulo}</h2>
  <div class="mx-auto mt-10 grid max-w-3xl gap-3">
    {
      preguntas.map((p, i) => (
        <details
          data-reveal
          style={`--reveal-delay:${i * 60}ms`}
          class="group rounded-2xl border border-gray-200 bg-white open:border-primary/30 open:shadow-soft"
          open={i === 0}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-bold text-navy [&::-webkit-details-marker]:hidden">
            {p.pregunta}
            <Icon name="plus" size={20} class="shrink-0 text-primary transition-transform duration-300 group-open:rotate-45" />
          </summary>
          <p class="px-5 pb-5 leading-relaxed text-gray-600">{p.respuesta}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
</section>
