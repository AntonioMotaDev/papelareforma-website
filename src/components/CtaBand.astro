---
import Icon from './Icon.astro';
import { urlWhatsApp } from '@/lib/utils';

interface Props {
  titulo?: string;
  descripcion?: string;
}
const {
  titulo = '¿Buscas algo en particular?',
  descripcion = 'Pregúntanos por WhatsApp si lo tenemos y cuánto cuesta. Te contestamos en horario de atención.',
} = Astro.props;
---

<section class="container-page py-14 sm:py-20" aria-labelledby="cta-titulo">
  <div
    data-reveal
    class="relative isolate grid items-center gap-8 overflow-hidden rounded-3xl bg-celeste-50 px-6 py-10 text-center ring-1 ring-celeste sm:px-10 lg:grid-cols-[1fr_2fr_1fr] lg:py-12"
  >
    <!-- Isotipo oficial (public/favicon.svg) como ilustración -->
    <img src="/favicon.svg" alt="" width="180" height="172" loading="lazy" class="mx-auto hidden w-40 lg:block" />

    <div>
      <h2 id="cta-titulo" class="text-3xl font-extrabold sm:text-4xl">{titulo}</h2>
      <p class="mx-auto mt-3 max-w-md text-lg text-gray-600">{descripcion}</p>
      <a href={urlWhatsApp()} target="_blank" rel="noopener" class="btn btn-whatsapp mt-7 h-14 px-7 text-base">
        <Icon name="whatsapp" size={22} />
        Escríbenos por WhatsApp
      </a>
    </div>

    <div class="relative mx-auto hidden size-36 lg:block" aria-hidden="true">
      <span class="absolute inset-0 rotate-6 rounded-[2rem] border-4 border-navy bg-white"></span>
      <span class="absolute inset-0 grid place-items-center text-green-700">
        <Icon name="whatsapp" size={64} />
      </span>
      <span class="absolute -top-3 -right-4 h-8 w-2 rotate-45 rounded-full bg-yellow"></span>
      <span class="absolute top-6 -right-6 h-2 w-7 rounded-full bg-green"></span>
      <span class="absolute -bottom-2 -left-5 h-2 w-6 -rotate-12 rounded-full bg-coral"></span>
    </div>
  </div>
</section>
