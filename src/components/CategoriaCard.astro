---
import Icon from './Icon.astro';
import Foto from './Foto.astro';
import type { ArticuloCatalogo } from '@/lib/negocio';

interface Props {
  categoria: ArticuloCatalogo;
  href: string;
  tono?: 'azul' | 'verde' | 'amarillo' | 'coral';
  retraso?: number;
  /** Muestra la descripción bajo el nombre (página de productos). */
  conDescripcion?: boolean;
}
const { categoria, href, tono, retraso = 0, conDescripcion = false } = Astro.props;
---

<a
  {href}
  id={conDescripcion ? categoria.id : undefined}
  data-reveal
  style={`--reveal-delay:${retraso}ms`}
  class="group flex h-full scroll-mt-28 flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-soft transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lift"
  {...href.startsWith('http') && { target: '_blank', rel: 'noopener' }}
>
  <Foto
    nombre={categoria.id}
    alt={categoria.nombre}
    icono={categoria.icono}
    {tono}
    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
    class="aspect-[16/9] w-full transition-transform duration-500 group-hover:scale-[1.03]"
  />
  <span class="flex flex-1 items-start justify-between gap-2 px-4 py-3.5 sm:px-5 sm:py-4">
    <span>
      <span class="block font-bold text-navy sm:text-lg">{categoria.nombre}</span>
      {conDescripcion && <span class="mt-1 block text-gray-600">{categoria.descripcion}</span>}
    </span>
    <Icon name="arrow-right" size={20} class="mt-0.5 shrink-0 text-navy transition-transform group-hover:translate-x-1" />
  </span>
</a>
