---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { negocio } from '@/lib/negocio';
import { cx, urlTelefono, urlWhatsApp } from '@/lib/utils';

const rutaActual = Astro.url.pathname.replace(/\/$/, '') || '/';
const esActiva = (href: string) => (href === '/' ? rutaActual === '/' : rutaActual.startsWith(href));
---

<header
  id="encabezado"
  class="on-dark sticky top-0 z-50 border-b border-white/10 bg-navy text-white transition-shadow duration-300 data-[scrolled=true]:shadow-[0_10px_30px_-12px_rgb(1_26_49/0.6)]"
>
  <div class="container-page flex h-[4.5rem] items-center justify-between gap-6">
    <a href="/" class="shrink-0 rounded-lg" aria-label={`${negocio.nombre} — Inicio`}>
      <Logo fondo="dark" alto={40} eager />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          negocio.sitio.navegacion.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={esActiva(item.href) ? 'page' : undefined}
                class={cx(
                  'relative rounded-full px-3.5 py-2 text-[0.93rem] font-medium transition-colors',
                  'after:absolute after:inset-x-3.5 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:rounded-full after:bg-yellow after:transition-transform after:duration-300',
                  'hover:text-white hover:after:scale-x-100',
                  esActiva(item.href) ? 'text-white after:scale-x-100' : 'text-white/75',
                )}
              >
                {item.etiqueta}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={urlTelefono()}
        class="hidden items-center gap-2 rounded-full px-3 py-2 text-sm font-medium text-white/80 transition-colors hover:text-white xl:inline-flex"
      >
        <Icon name="phone" size={16} />
        {negocio.contacto.telefono}
      </a>

      <!-- TODO(Carrito): Integración future con API -->
      {/* TODO(Carrito): botón de carrito. Ver src/lib/carrito.ts
      <a href="/carrito" class="relative inline-flex size-11 items-center justify-center rounded-full hover:bg-white/10" aria-label="Carrito (0 artículos)">
        <Icon name="shopping-cart" size={20} />
        <span data-cart-count class="absolute -top-0.5 -right-0.5 grid size-5 place-items-center rounded-full bg-yellow text-[0.7rem] font-bold text-navy">0</span>
      </a>
      */}

      <a
        href={urlWhatsApp()}
        target="_blank"
        rel="noopener"
        class="btn btn-primary hidden min-h-11 px-5 text-sm sm:inline-flex"
      >
        <Icon name="whatsapp" size={18} />
        Cotiza por WhatsApp
      </a>

      <button
        type="button"
        id="menu-boton"
        class="inline-flex size-11 items-center justify-center rounded-full text-white transition-colors hover:bg-white/10 lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
      >
        <Icon name="menu" size={24} class="menu-abrir" />
        <Icon name="x" size={24} class="menu-cerrar hidden" />
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div
    id="menu-movil"
    class="grid grid-rows-[0fr] border-white/10 transition-[grid-template-rows] duration-300 ease-out data-[open=true]:grid-rows-[1fr] data-[open=true]:border-t lg:hidden"
    data-open="false"
  >
    <div class="overflow-hidden">
      <nav aria-label="Principal (móvil)" class="container-page pt-3 pb-6" inert>
        <ul class="flex flex-col">
          {
            negocio.sitio.navegacion.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={esActiva(item.href) ? 'page' : undefined}
                  class={cx(
                    'flex items-center justify-between rounded-xl px-3 py-3.5 text-lg font-medium transition-colors hover:bg-white/10',
                    esActiva(item.href) ? 'text-yellow' : 'text-white',
                  )}
                >
                  {item.etiqueta}
                  <Icon name="chevron-right" size={18} class="text-white/40" />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-4 grid gap-3 border-t border-white/10 pt-5">
          <OpenStatus variante="pill-dark" />
          <a href={urlWhatsApp()} target="_blank" rel="noopener" class="btn btn-primary w-full">
            <Icon name="whatsapp" size={18} />
            Cotiza por WhatsApp
          </a>
          <a href={urlTelefono()} class="btn btn-outline-light w-full">
            <Icon name="phone" size={18} />
            Llamar al {negocio.contacto.telefono}
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const encabezado = document.getElementById('encabezado')!;
  const boton = document.getElementById('menu-boton')!;
  const panel = document.getElementById('menu-movil')!;
  const navMovil = panel.querySelector('nav')!;

  // Sombra al hacer scroll (sentinel sin listeners de scroll costosos).
  const centinela = document.createElement('div');
  centinela.setAttribute('aria-hidden', 'true');
  centinela.style.cssText = 'position:absolute;top:0;height:1px;width:1px;';
  document.body.prepend(centinela);
  new IntersectionObserver(([e]) => {
    encabezado.dataset.scrolled = String(!e!.isIntersecting);
  }).observe(centinela);

  function alternar(abrir: boolean) {
    panel.dataset.open = String(abrir);
    boton.setAttribute('aria-expanded', String(abrir));
    boton.setAttribute('aria-label', abrir ? 'Cerrar menú' : 'Abrir menú');
    boton.querySelector('.menu-abrir')!.classList.toggle('hidden', abrir);
    boton.querySelector('.menu-cerrar')!.classList.toggle('hidden', !abrir);
    navMovil.inert = !abrir;
    if (abrir) navMovil.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
  }

  boton.addEventListener('click', () => alternar(panel.dataset.open !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel.dataset.open === 'true') {
      alternar(false);
      boton.focus();
    }
  });
  panel.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) alternar(false);
  });
  matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && alternar(false));
</script>
