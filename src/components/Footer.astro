---
import Logo from './Logo.astro';
import Icon, { type NombreIcono } from './Icon.astro';
import { negocio } from '@/lib/negocio';
import { direccionCompleta, resumenHorarios, urlGoogleMaps, urlWhatsApp } from '@/lib/utils';

const anio = new Date().getFullYear();
const iconoRed: Record<string, NombreIcono> = { Facebook: 'facebook', Instagram: 'instagram', TikTok: 'tiktok' };
const enlaces = [
  ...negocio.sitio.navegacion,
  { etiqueta: 'Lista escolar', href: '/lista-escolar' },
  { etiqueta: 'Contacto', href: '/contacto' },
];
---

<footer class="on-dark bg-navy text-white/80">
  <div
    class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[auto_1fr_auto_auto] lg:items-start lg:gap-0 lg:divide-x lg:divide-white/15"
  >
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center lg:pr-10">
      <a href="/" class="inline-block self-start rounded-2xl bg-white px-4 py-3" aria-label={`${negocio.nombre} — Inicio`}>
        <Logo alto={52} />
      </a>
      <p class="max-w-56 text-sm leading-relaxed">
        <strong class="block text-base text-white">{negocio.nombre}</strong>
        Útiles, papelería y artículos para tu día a día.
      </p>
    </div>

    <nav aria-label="Pie de página" class="lg:px-10">
      <ul class="flex flex-wrap gap-x-6 gap-y-3 text-[0.95rem] lg:justify-center lg:pt-4">
        {
          enlaces.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-yellow">
                {item.etiqueta}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="space-y-3 text-sm lg:px-10">
      <h2 class="font-bold text-white">Contacto</h2>
      <a href={urlWhatsApp()} target="_blank" rel="noopener" class="flex gap-2.5 hover:text-yellow">
        <Icon name="whatsapp" size={18} class="shrink-0 text-yellow" />
        WhatsApp {negocio.contacto.telefono}
      </a>
      <a href={urlGoogleMaps()} target="_blank" rel="noopener" class="flex max-w-64 gap-2.5 hover:text-yellow">
        <Icon name="map-pin" size={18} class="shrink-0 text-yellow" />
        <address class="not-italic">{direccionCompleta()}</address>
      </a>
      <p class="flex max-w-64 gap-2.5">
        <Icon name="clock" size={18} class="shrink-0 text-yellow" />
        {resumenHorarios()}
      </p>
    </div>

    {
      negocio.redes.length > 0 && (
        <div class="space-y-3 text-sm lg:pl-10">
          <h2 class="font-bold text-white">Redes sociales</h2>
          <ul class="flex gap-2">
            {negocio.redes.map((red) => (
              <li>
                <a
                  href={red.url}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex size-11 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-yellow hover:text-navy"
                  aria-label={`${red.nombre} (${red.usuario})`}
                >
                  <Icon name={iconoRed[red.nombre] ?? 'external-link'} size={20} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-5 text-sm text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {anio} {negocio.nombre}. Todos los derechos reservados.</p>
      <p>
        Sitio desarrollado por{' '}
        <a
          href="https://forma01.net"
          target="_blank"
          rel="noopener"
          class="font-semibold text-white/80 underline-offset-4 hover:text-yellow hover:underline">FORMA/01</a
        >
      </p>
    </div>
  </div>
</footer>
