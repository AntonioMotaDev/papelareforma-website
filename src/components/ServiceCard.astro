---
import Icon from './Icon.astro';
import type { Servicio } from '@/lib/negocio';
import { formatearPrecio, urlWhatsApp } from '@/lib/utils';

interface Props {
  servicio: Servicio;
  /** Retraso de la animación de entrada (ms), para escalonar la cuadrícula. */
  retraso?: number;
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { servicio, retraso = 0, headingLevel: Titulo = 'h3' } = Astro.props;
const { precio } = servicio;
---

<article
  id={servicio.id}
  data-reveal
  style={`--reveal-delay:${retraso}ms`}
  class="group relative flex h-full scroll-mt-28 flex-col overflow-hidden rounded-2xl border border-gray-200/80 bg-white p-6 shadow-soft transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-primary/25 hover:shadow-lift sm:p-7"
>
  <!-- Acento superior que se dibuja al pasar el cursor -->
  <span
    class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gradient-to-r from-primary via-green to-yellow transition-transform duration-500 ease-out group-hover:scale-x-100"
    aria-hidden="true"></span>

  <div class="flex items-start justify-between gap-4">
    <span
      class="grid size-14 place-items-center rounded-2xl bg-navy/5 text-primary transition-colors duration-300 group-hover:bg-navy group-hover:text-yellow"
    >
      <Icon name={servicio.icono} size={26} />
    </span>
    {
      servicio.alias && (
        <span class="rounded-full bg-yellow-50 px-3 py-1 text-xs font-semibold text-navy ring-1 ring-yellow/40">
          {servicio.alias}
        </span>
      )
    }
  </div>

  <Titulo class="mt-6 text-xl font-semibold">{servicio.nombre}</Titulo>
  <p class="mt-2 flex-1 leading-relaxed text-gray-600">{servicio.descripcion}</p>

  <div class="mt-6 flex flex-wrap items-end justify-between gap-4 border-t border-gray-100 pt-5">
    <div class="min-w-0 grow basis-36">
      {
        precio.monto !== null ? (
          <>
            <p class="text-xs font-semibold tracking-wide text-gray-500 uppercase">
              {precio.desde ? 'Desde' : 'Precio'}
            </p>
            <p class="font-display text-2xl font-bold text-navy">{formatearPrecio(precio.monto)}</p>
            {precio.unidad && <p class="text-sm text-gray-500">{precio.unidad}</p>}
          </>
        ) : (
          <>
            <p class="text-xs font-semibold tracking-wide text-gray-500 uppercase">Precio</p>
            <p class="font-display text-lg font-semibold text-navy">Consulta en tienda</p>
          </>
        )
      }
      {precio.nota && <p class="mt-1 text-xs leading-snug text-gray-500">{precio.nota}</p>}
    </div>

    <a
      href={urlWhatsApp(servicio.mensajeWhatsApp)}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-white transition-[background-color,transform] duration-200 hover:bg-primary-700 active:scale-95"
    >
      Consultar<span class="sr-only"> {servicio.nombre} por WhatsApp</span>
      <Icon name="arrow-right" size={16} class="transition-transform duration-200 group-hover:translate-x-0.5" />
    </a>
    <!-- TODO(Carrito): Integración future con API — botón "Agregar a cotización" (ver src/lib/carrito.ts) -->
  </div>
</article>
