---
/**
 * Reseñas de Google con datos fijos de `negocio.resenas` (sin widgets ni APIs
 * externas). Sin reseñas destacadas, se muestra solo la calificación y el
 * enlace al perfil.
 */
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { negocio } from '@/lib/negocio';

const { calificacion, total, urlPerfil, destacadas } = negocio.resenas;
---

<section class="container-page py-16 sm:py-24" aria-labelledby="resenas-titulo">
  <SectionHeading id="resenas-titulo" titulo="Lo que dicen nuestros clientes." />

  <div data-reveal class="mt-8 flex flex-col items-center gap-5 text-center">
    <div class="flex items-center gap-4">
      <p class="font-display text-6xl leading-none font-extrabold text-navy">
        <span class="sr-only">Calificación de </span>{calificacion.toFixed(1)}<span class="sr-only"> de 5</span>
      </p>
      <div class="flex flex-col items-start gap-1.5">
        <span class="flex text-yellow" aria-hidden="true">
          {Array.from({ length: 5 }, () => <Icon name="star" size={22} />)}
        </span>
        <p class="font-semibold text-gray-600">{total} reseñas en Google</p>
      </div>
    </div>
    <a href={urlPerfil} target="_blank" rel="noopener" class="btn btn-outline">
      Ver reseñas en Google
      <Icon name="external-link" size={16} />
      <span class="sr-only">(se abre en Google Maps)</span>
    </a>
  </div>

  {
    destacadas.length > 0 && (
      <ul class="mt-12 gap-5 sm:columns-2 lg:columns-3">
        {destacadas.map((r, i) => (
          <li
            data-reveal
            style={`--reveal-delay:${(i % 3) * 70}ms`}
            class="card mb-5 flex break-inside-avoid flex-col p-6"
          >
            <span class="flex text-yellow" aria-hidden="true">
              {Array.from({ length: r.estrellas }, () => (
                <Icon name="star" size={16} />
              ))}
            </span>
            <span class="sr-only">{r.estrellas} de 5 estrellas</span>
            <blockquote class="mt-3 leading-relaxed text-gray-700">
              <p>“{r.texto}”</p>
            </blockquote>
            <div class="mt-5 flex items-center gap-3">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-full bg-celeste-50 font-bold text-primary uppercase ring-1 ring-celeste"
                aria-hidden="true"
              >
                {r.autor.charAt(0)}
              </span>
              <p class="text-sm leading-snug">
                <span class="block font-bold text-navy">{r.autor}</span>
                <span class="text-gray-600">
                  {r.guiaLocal && 'Local Guide · '}
                  {r.fecha} ·{' '}
                  <a href={r.url} target="_blank" rel="noopener" class="link font-semibold">
                    Ver en Google<span class="sr-only"> la reseña de {r.autor} (se abre en Google Maps)</span>
                  </a>
                </span>
              </p>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</section>
