export type NombreIcono = keyof typeof trazos | keyof typeof rellenos;

interface Props extends HTMLAttributes<'svg'> {
  name: NombreIcono;
  size?: number;
  /** Texto accesible. Sin él, el ícono es decorativo (aria-hidden). */
  label?: string;
}

const { name, size = 20, label, ...attrs } = Astro.props;
const esRelleno = name in rellenos;
const contenido = esRelleno
  ? rellenos[name as keyof typeof rellenos]
  : trazos[name as keyof typeof trazos];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={esRelleno ? 'currentColor' : 'none'}
  stroke={esRelleno ? 'none' : 'currentColor'}
  stroke-width={esRelleno ? undefined : 2}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  {...attrs}
  set:html={contenido}
/>
