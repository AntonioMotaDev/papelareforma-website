---
/**
 * Logotipo horizontal en negativo ("PAPE" y descriptor en blanco), para los
 * fondos azul marino del header y el footer, como pide el manual de marca.
 * Se generó de Branding/Oficial/Logotipo-Horizontal-Vector.svg quitando el fondo
 * y pasando los azules a blanco.
 */
import { Image } from 'astro:assets';
import logo from '@/assets/logos/logo-horizontal-negativo.svg';
import { negocio } from '@/lib/negocio';
import { cx } from '@/lib/utils';

interface Props {
  class?: string;
  /** Altura en px del logo. */
  alto?: number;
  eager?: boolean;
}

const { class: clase, alto = 40, eager = false } = Astro.props;
---

<Image
  src={logo}
  alt={negocio.nombre}
  height={alto}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class={cx('w-auto', clase)}
  style={`height:${alto}px`}
/>
