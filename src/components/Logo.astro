---
/**
 * Logotipo horizontal oficial a color (Branding/Oficial/Logo_Horizontal_Bco_SinFondo.png,
 * recortado). Va siempre sobre blanco: el manual pide logo a color en fondo blanco.
 */
import { Image } from 'astro:assets';
import logo from '@/assets/logos/logo-horizontal.png';
import { negocio } from '@/lib/negocio';
import { cx } from '@/lib/utils';

interface Props {
  class?: string;
  /** Altura en px del logo. */
  alto?: number;
  eager?: boolean;
}

const { class: clase, alto = 40, eager = false } = Astro.props;
---

<Image
  src={logo}
  alt={negocio.nombre}
  height={alto}
  densities={[1, 2]}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class={cx('w-auto', clase)}
  style={`height:${alto}px`}
/>
