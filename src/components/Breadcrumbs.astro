---
import Icon from './Icon.astro';
import type { Miga } from '@/lib/seo';

interface Props {
  migas: Miga[];
}
const { migas } = Astro.props;
---

<nav aria-label="Ruta de navegación">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-white/70">
    {
      migas.map((m, i) => {
        const ultima = i === migas.length - 1;
        return (
          <li class="flex items-center gap-1.5">
            {i > 0 && <Icon name="chevron-right" size={14} class="text-white/40" />}
            {ultima ? (
              <span aria-current="page" class="font-medium text-white">
                {m.nombre}
              </span>
            ) : (
              <a href={m.href} class="inline-flex items-center gap-1 transition-colors hover:text-yellow">
                {i === 0 && <Icon name="home" size={14} />}
                {m.nombre}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
