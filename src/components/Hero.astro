---
/**
 * Hero de la página de inicio. La foto sale de `src/assets/images/hero.jpg`
 * (ver Foto.astro); mientras no exista se muestra un relleno de marca.
 */
import Icon from './Icon.astro';
import Foto from './Foto.astro';
import OpenStatus from './OpenStatus.astro';
import { negocio } from '@/lib/negocio';
import { urlComoLlegar, urlWhatsApp } from '@/lib/utils';
---

<section class="relative isolate overflow-hidden bg-celeste-50/70">
  <div class="container-page grid items-center gap-12 pt-12 pb-16 sm:pt-16 lg:grid-cols-2 lg:gap-14 lg:pt-20 lg:pb-24">
    <div>
      <p class="eyebrow animate-fade-up">Tu papelería de confianza</p>

      <h1
        class="animate-fade-up relative mt-5 text-[2.5rem] leading-[1.08] font-extrabold [animation-delay:80ms] sm:text-5xl lg:text-[3.5rem]"
      >
        <span class="relative">
          Todo para tus ideas,
          <!-- Trazos de apoyo, como los del isotipo -->
          <svg
            class="absolute -top-5 -right-9 hidden h-8 w-10 sm:block"
            viewBox="0 0 48 40"
            fill="none"
            stroke-linecap="round"
            stroke-width="4"
            aria-hidden="true"
          >
            <path d="M14 30 20 8" stroke="#0A5CB5" />
            <path d="M26 32 40 18" stroke="#5FAF2F" />
          </svg>
        </span>
        <br class="hidden sm:block" />
        tu escuela y tu <span class="whitespace-nowrap">día a día.</span>
      </h1>

      <p class="animate-fade-up mt-6 max-w-xl text-lg leading-relaxed text-gray-600 [animation-delay:160ms]">
        Útiles escolares, oficina, copias e impresiones en {negocio.ubicacion.calle}. Más de
        {negocio.experiencia.anios} años en la colonia.
      </p>

      <div class="animate-fade-up mt-8 flex flex-col gap-3 [animation-delay:240ms] sm:flex-row">
        <a href={urlWhatsApp()} target="_blank" rel="noopener" class="btn btn-primary h-13 px-6 text-base">
          <Icon name="whatsapp" size={20} />
          Consultar por WhatsApp
        </a>
        <a href={urlComoLlegar()} target="_blank" rel="noopener" class="btn btn-outline h-13 px-6 text-base">
          <Icon name="map-pin" size={18} />
          Cómo llegar
        </a>
      </div>

      <div class="animate-fade-up mt-7 [animation-delay:320ms]">
        <OpenStatus />
      </div>
    </div>

    <div class="animate-fade-up relative mx-auto w-full max-w-xl [animation-delay:200ms]">
      <!-- Manchas de color del manual detrás de la foto -->
      <span class="absolute -top-6 -left-6 -z-10 size-40 rounded-[40%] bg-yellow/80 sm:size-48" aria-hidden="true"></span>
      <span class="absolute -bottom-6 -left-4 -z-10 size-24 rounded-full bg-coral/80" aria-hidden="true"></span>
      <span class="absolute -right-3 top-10 -z-10 h-24 w-6 rotate-12 rounded-full bg-coral/70" aria-hidden="true"></span>
      <Foto
        nombre="hero"
        alt={`Artículos de papelería en ${negocio.nombre}`}
        icono="pen"
        sizes="(min-width: 1024px) 45vw, 100vw"
        eager
        class="aspect-[4/3] w-full rounded-3xl shadow-lift ring-1 ring-black/5"
      />
    </div>
  </div>
</section>
