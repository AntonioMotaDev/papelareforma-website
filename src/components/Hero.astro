---
/**
 * Hero de la página de inicio. La foto sale de `src/assets/images/hero.jpg`
 * (ver Foto.astro); mientras no exista se muestra un relleno de marca.
 * En móvil la foto va arriba a todo lo ancho; en escritorio ocupa la mitad
 * derecha a sangre (de arriba abajo y hasta la orilla de la pantalla).
 */
import Icon from './Icon.astro';
import Foto from './Foto.astro';
import OpenStatus from './OpenStatus.astro';
import { negocio } from '@/lib/negocio';
import { urlComoLlegar, urlWhatsApp } from '@/lib/utils';

const { resenas } = negocio;
---

<section data-hero class="relative isolate overflow-hidden bg-celeste-50/70">
  <div
    class="relative h-[clamp(13rem,38svh,20rem)] sm:h-[24rem] lg:absolute lg:inset-y-0 lg:right-0 lg:h-auto lg:w-[52%]"
  >
    <!-- Manchas de color del manual en la unión entre texto y foto -->
    <span class="absolute top-[16%] -left-12 -z-10 hidden size-28 rounded-[40%] bg-yellow/80 lg:block" aria-hidden="true"
    ></span>
    <span
      class="absolute bottom-[24%] -left-2.5 z-10 hidden h-20 w-5 rotate-12 rounded-full bg-coral/85 lg:block"
      aria-hidden="true"></span>

    <Foto
      nombre="hero"
      alt={`Interior de ${negocio.nombre}: mochilas, termos, cuadernos y copiadoras`}
      icono="pen"
      sizes="(min-width: 1024px) 52vw, 100vw"
      widths={[640, 960, 1448]}
      eager
      class="absolute inset-0 size-full object-[center_45%]"
    />

    <!-- Sello de reseñas: la prueba de confianza más visible -->
    <a
      href={resenas.urlPerfil}
      target="_blank"
      rel="noopener"
      class="absolute right-3 bottom-3 z-10 flex items-center gap-3 rounded-2xl bg-white/95 px-4 py-3 text-navy shadow-lift ring-1 ring-black/5 backdrop-blur-sm transition-transform duration-300 hover:-translate-y-0.5 sm:right-5 sm:bottom-5 lg:right-auto lg:bottom-8 lg:left-10"
    >
      <span class="font-display text-3xl leading-none font-extrabold">
        <span class="sr-only">Calificación de </span>{resenas.calificacion.toFixed(1)}<span class="sr-only">
          de 5,</span
        >
      </span>
      <span class="flex flex-col gap-1">
        <span class="flex text-yellow" aria-hidden="true">
          {Array.from({ length: 5 }, () => <Icon name="star" size={16} />)}
        </span>
        <span class="text-xs font-semibold text-gray-600">
          {resenas.total} reseñas en Google<span class="sr-only"> (se abre en Google Maps)</span>
        </span>
      </span>
    </a>
  </div>

  <div class="container-page">
    <div
      class="pt-9 pb-14 sm:pt-12 sm:pb-16 lg:flex lg:min-h-[min(44rem,calc(100svh-4.5rem))] lg:w-[48%] lg:flex-col lg:items-start lg:justify-center lg:py-20 lg:pr-12"
    >
      <p class="eyebrow animate-fade-up">Tu papelería desde {negocio.experiencia.anioFundacion}</p>
      <h1
        class="animate-fade-up relative mt-5 text-[2.25rem] leading-[1.08] font-extrabold [animation-delay:80ms] sm:text-5xl lg:text-[2.75rem] xl:text-[3.5rem]"
      >
        <span class="relative">
          Todo para tus ideas,
          <!-- Trazos de apoyo, como los del isotipo -->
          <svg
            class="absolute -top-5 -right-9 hidden h-8 w-10 sm:block lg:hidden xl:block"
            viewBox="0 0 48 40"
            fill="none"
            stroke-linecap="round"
            stroke-width="4"
            aria-hidden="true"
          >
            <path d="M14 30 20 8" stroke="#0A5CB5" />
            <path d="M26 32 40 18" stroke="#5FAF2F" />
          </svg>
        </span>
        <br class="hidden sm:block lg:hidden xl:block" />
        tu escuela y tu <span class="whitespace-nowrap">día a día.</span>
      </h1>
      <p class="animate-fade-up mt-6 max-w-xl text-lg leading-relaxed text-gray-600 [animation-delay:160ms]">
        Útiles escolares, artículos de oficina, copias e impresiones en {negocio.ubicacion.ciudad}. Pídelo por
        WhatsApp o visítanos en {negocio.ubicacion.calle}.
      </p>
      <div class="animate-fade-up mt-8 flex flex-col gap-3 [animation-delay:240ms] sm:flex-row">
        <a href={urlWhatsApp()} target="_blank" rel="noopener" class="btn btn-primary h-13 px-6 text-base">
          <Icon name="whatsapp" size={20} />
          Consultar por WhatsApp
        </a>
        <a href={urlComoLlegar()} target="_blank" rel="noopener" class="btn btn-outline h-13 px-6 text-base">
          <Icon name="map-pin" size={18} />
          Cómo llegar
        </a>
      </div>
      <div class="animate-fade-up mt-7 [animation-delay:320ms]">
        <OpenStatus />
      </div>
    </div>
  </div>
</section>
