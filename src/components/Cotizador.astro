---
/**
 * Calculadora de cotización: el cliente elige cantidades y se arma un mensaje de
 * WhatsApp con el estimado. Los precios salen de los servicios (negocio.ts / API),
 * nunca se escriben aquí. Sin JavaScript se muestra solo el botón a WhatsApp.
 */
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { negocio } from '@/lib/negocio';
import { obtenerServicios } from '@/lib/api';
import { formatearPrecio, urlWhatsApp } from '@/lib/utils';

const servicios = await obtenerServicios();
const filas = negocio.cotizador.flatMap((c) => {
  const servicio = servicios.find((s) => s.id === c.servicioId);
  return servicio && servicio.precio.monto !== null ? [{ ...c, servicio, monto: servicio.precio.monto }] : [];
});

const mensajeVacio = 'Hola, me gustaría pedir una cotización.';
// Termina en `?text=`: el script le agrega el mensaje codificado.
const base = urlWhatsApp('');
---

<section class="container-page py-16 sm:py-24" aria-labelledby="cotizador-titulo" id="cotizador">
  <SectionHeading
    id="cotizador-titulo"
    eyebrow="Cotizador"
    titulo="Calcula tu cotización"
    descripcion="Elige cuántas copias, impresiones o engargolados necesitas y mándanos el pedido por WhatsApp ya armado."
  />

  <noscript>
    <p class="mx-auto mt-8 max-w-xl text-center text-gray-600">
      La calculadora necesita JavaScript. Escríbenos por
      <a href={urlWhatsApp(mensajeVacio)} class="link" target="_blank" rel="noopener">WhatsApp</a> y te cotizamos.
    </p>
  </noscript>

  <div
    hidden
    data-cotizador
    data-wa={base}
    data-msg-vacio={mensajeVacio}
    class="mx-auto mt-12 grid max-w-5xl items-start gap-6 lg:grid-cols-[3fr_2fr]"
  >
    <ul class="grid gap-3" data-reveal>
      {
        filas.map((f) => (
          <li
            data-fila
            data-precio={f.monto}
            data-singular={f.singular}
            data-plural={f.plural}
            class="card flex flex-wrap items-center gap-x-4 gap-y-3 p-4 sm:p-5"
          >
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-navy/5 text-primary">
              <Icon name={f.servicio.icono} size={24} />
            </span>
            <div class="min-w-0 flex-1 basis-40">
              <label for={`cot-${f.servicioId}`} class="block font-bold text-navy">
                {f.etiqueta} <span class="font-medium text-gray-500">({f.unidad})</span>
              </label>
              <p class="text-sm text-gray-600">
                {f.servicio.precio.desde ? 'Desde ' : ''}
                {formatearPrecio(f.monto)}
                {f.servicio.precio.unidad ? ` ${f.servicio.precio.unidad}` : ''}
              </p>
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                hidden
                data-accion="menos"
                aria-label={`Quitar uno: ${f.etiqueta}`}
                class="grid size-11 place-items-center rounded-xl border border-gray-300 text-navy transition-colors hover:border-primary hover:text-primary active:scale-95"
              >
                <Icon name="minus" size={18} />
              </button>
              <input
                id={`cot-${f.servicioId}`}
                type="number"
                inputmode="numeric"
                min="0"
                max="9999"
                step="1"
                value="0"
                class="h-11 w-20 [appearance:textfield] rounded-xl border border-gray-300 bg-white text-center text-base font-semibold text-navy tabular-nums focus:border-primary focus:shadow-[0_0_0_4px_rgb(10_92_181/0.15)] focus:outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
              />
              <button
                type="button"
                hidden
                data-accion="mas"
                aria-label={`Agregar uno: ${f.etiqueta}`}
                class="grid size-11 place-items-center rounded-xl border border-gray-300 text-navy transition-colors hover:border-primary hover:text-primary active:scale-95"
              >
                <Icon name="plus" size={18} />
              </button>
            </div>
            <p
              data-subtotal
              class="w-full text-right text-sm font-semibold text-gray-500 tabular-nums sm:w-24 sm:text-base"
            >
              —
            </p>
          </li>
        ))
      }
    </ul>

    <div class="card p-6 lg:sticky lg:top-28" data-reveal style="--reveal-delay:80ms">
      <h3 class="text-xl font-bold">Tu cotización</h3>
      <p class="mt-4 text-sm font-semibold tracking-wide text-gray-500 uppercase">Total estimado</p>
      <output data-total aria-live="polite" class="block text-4xl font-extrabold text-navy tabular-nums">$0.00</output>
      <p class="mt-2 text-sm leading-snug text-gray-600">
        Calculado con precios base. El precio baja en volumen y el total final lo confirmamos por WhatsApp según papel,
        tamaño y cantidad.
      </p>

      <label for="cot-notas" class="mt-5 block text-sm font-semibold text-navy">
        ¿Algo más? <span class="font-medium text-gray-500">(opcional)</span>
      </label>
      <textarea
        id="cot-notas"
        rows="3"
        maxlength="300"
        placeholder="Color o blanco y negro, tamaño, tipo de papel…"
        class="mt-1.5 block w-full resize-none rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-gray-900 placeholder:text-gray-500 focus:border-primary focus:shadow-[0_0_0_4px_rgb(10_92_181/0.15)] focus:outline-none"
      ></textarea>

      <a
        data-enviar
        href={urlWhatsApp(mensajeVacio)}
        target="_blank"
        rel="noopener"
        class="btn btn-whatsapp mt-5 w-full"
      >
        <Icon name="whatsapp" size={20} />
        Pedir por WhatsApp
      </a>
      <p class="mt-3 text-center text-sm text-gray-500">Después te pedimos tus archivos por el mismo chat.</p>
    </div>
  </div>
</section>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-cotizador]');

  if (raiz) {
    const moneda = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' });
    const filas = [...raiz.querySelectorAll<HTMLElement>('[data-fila]')];
    const total = raiz.querySelector<HTMLOutputElement>('[data-total]')!;
    const notas = raiz.querySelector<HTMLTextAreaElement>('#cot-notas')!;
    const enviar = raiz.querySelector<HTMLAnchorElement>('[data-enviar]')!;

    const cantidadDe = (input: HTMLInputElement) => {
      const n = Math.floor(Number(input.value));
      return Number.isFinite(n) ? Math.min(Math.max(n, 0), 9999) : 0;
    };

    const actualizar = () => {
      let suma = 0;
      const lineas: string[] = [];

      for (const fila of filas) {
        const n = cantidadDe(fila.querySelector('input')!);
        const subtotal = n * Number(fila.dataset.precio);
        suma += subtotal;
        fila.querySelector('[data-subtotal]')!.textContent = n ? moneda.format(subtotal) : '—';
        if (n) lineas.push(`• ${n} ${n === 1 ? fila.dataset.singular : fila.dataset.plural}`);
      }

      total.textContent = moneda.format(suma);

      const extra = notas.value.trim();
      const mensaje = lineas.length
        ? [
            'Hola, quiero cotizar:',
            ...lineas,
            `Total estimado con precios base: ${moneda.format(suma)}.`,
            ...(extra ? [`Notas: ${extra}`] : []),
            '¿Me confirmas el total?',
          ].join('\n')
        : [raiz.dataset.msgVacio, ...(extra ? [`Notas: ${extra}`] : [])].join('\n');

      enviar.href = raiz.dataset.wa + encodeURIComponent(mensaje);
    };

    raiz.addEventListener('input', actualizar);
    raiz.addEventListener('change', (e) => {
      // Normaliza lo escrito (vacío, negativo, decimales) al salir del campo.
      if (e.target instanceof HTMLInputElement) e.target.value = String(cantidadDe(e.target));
      actualizar();
    });
    raiz.addEventListener('click', (e) => {
      const boton = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-accion]');
      if (!boton) return;
      const input = boton.closest('[data-fila]')!.querySelector('input')!;
      input.value = String(Math.min(Math.max(cantidadDe(input) + (boton.dataset.accion === 'mas' ? 1 : -1), 0), 9999));
      actualizar();
    });

    // Con JS: se muestra la calculadora y los botones + / −.
    raiz.querySelectorAll<HTMLElement>('[data-accion]').forEach((b) => (b.hidden = false));
    raiz.hidden = false;
    actualizar();
  }
</script>
