# Cloudflare Pages — cabeceras HTTP
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# ── Seguridad + caché por defecto (HTML: 5 minutos) ─────────────────────────
/*
  Cache-Control: public, max-age=300, stale-while-revalidate=60
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# ── Recursos con hash en el nombre: inmutables (1 año) ──────────────────────
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# ── Estáticos sin hash (íconos, imágenes de /public): 1 mes ─────────────────
/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/og-image.png
  ! Cache-Control
  Cache-Control: public, max-age=2592000
